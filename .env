# ─── SET YOUR PC's LOCAL IP ADDRESS HERE ──────────────────────────────────────
# 1. Open CMD on your PC and run: ipconfig
# 2. Find "IPv4 Address" under your Wi-Fi adapter
# 3. Replace 192.168.1.XX below with that IP address
# 4. Make sure your phone and PC are on the SAME Wi-Fi network
# 5. Restart Expo: npx expo start --clear

EXPO_PUBLIC_API_URL=http://192.168.1.8:8000
